        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WordGames ist ein shared-source Hobbyprojekt, welches in keiner Weise mit Josh Wardle oder der New York Times assoziiert ist. Sämtlicher Quellcode kann unter https://github.com/Jan-Frederic-Schmidt/WordGames gefunden werden.\n\nWordGames © 2026 by Jan Frédéric Schmidt is licensed under CC BY-NC-ND 4.0"
          }
